---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const selectedCategoryIds = Astro.url.searchParams
    .getAll('category')
    .map((value) => Number.parseInt(value, 10))
    .filter((value) => Number.isInteger(value) && value > 0);
const selectedPublisherId = Astro.url.searchParams.get('publisher');
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const activePublisherId = selectedPublisherId !== null && selectedPublisherId !== '' ? Number.parseInt(selectedPublisherId, 10) : null;
const games = await getAllGames(getDatabase(), {
    categoryIds: selectedCategoryIds,
    publisherId: activePublisherId,
});
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <form
      method="get"
      action="/"
      class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg"
      data-testid="game-filters"
    >
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <fieldset class="flex-1" data-testid="category-filters">
          <legend class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-300">Categories</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label
                class="flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/50 px-3 py-2 text-sm text-slate-200 focus-within:ring-2 focus-within:ring-blue-500"
                data-testid={`category-filter-label-${category.id}`}
              >
                <input
                  type="checkbox"
                  name="category"
                  value={String(category.id)}
                  checked={selectedCategoryIds.includes(category.id)}
                  class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-testid={`category-filter-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="w-full max-w-xs">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium uppercase tracking-wide text-slate-300">
            Publisher
          </label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={String(publisher.id)} selected={activePublisherId === publisher.id}>
                {publisher.name}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button
          type="submit"
          class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          data-testid="apply-filters-button"
        >
          Apply filters
        </button>
        {(selectedCategoryIds.length > 0 || activePublisherId !== null) && (
          <a
            href="/"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="clear-filters-button"
          >
            Clear filters
          </a>
        )}
      </div>
    </form>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
      <div data-testid="empty-state" class="hidden text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700">
        <p data-testid="empty-state-text" class="text-slate-300">No games match the selected filters.</p>
      </div>
    </div>
  </div>

  <script>
    const filterForm = document.querySelector('[data-testid="game-filters"]') as HTMLFormElement | null;
    const gameCards = [...document.querySelectorAll('[data-testid="game-card"]')] as HTMLAnchorElement[];
    const emptyState = document.querySelector('[data-testid="empty-state"]') as HTMLElement | null;

    const applyFilters = () => {
      const searchParams = new URLSearchParams(window.location.search);
      const categoryIds = searchParams
        .getAll('category')
        .map((value) => Number.parseInt(value, 10))
        .filter((value) => Number.isInteger(value) && value > 0);
      const publisherId = searchParams.get('publisher');
      const normalizedPublisherId = publisherId !== null && publisherId !== '' ? Number.parseInt(publisherId, 10) : null;
      let visibleCount = 0;

      for (const card of gameCards) {
        const cardCategoryId = card.dataset.gameCategoryId ? Number.parseInt(card.dataset.gameCategoryId, 10) : null;
        const cardPublisherId = card.dataset.gamePublisherId ? Number.parseInt(card.dataset.gamePublisherId, 10) : null;
        const matchesCategory = categoryIds.length === 0 || (cardCategoryId !== null && categoryIds.includes(cardCategoryId));
        const matchesPublisher = normalizedPublisherId === null || (cardPublisherId !== null && cardPublisherId === normalizedPublisherId);
        const shouldShow = matchesCategory && matchesPublisher;
        card.hidden = !shouldShow;

        if (shouldShow) {
          visibleCount += 1;
        }
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    };

    if (filterForm) {
      filterForm.addEventListener('submit', () => {
        requestAnimationFrame(() => {
          applyFilters();
        });
      });
    }

    applyFilters();
  </script>
</Layout>
